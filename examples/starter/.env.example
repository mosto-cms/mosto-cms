# Site secret, at least 32 characters: pnpm exec mosto-cms-auth secret
MOSTO_CMS_SECRET=

# Editors who can sign in at /admin. Hash passwords with: pnpm exec mosto-cms-auth hash-password
# MOSTO_CMS_EDITORS='[{"email":"you@example.com","name":"You","passwordHash":"scrypt.15.8.1...."}]'

# Revoked connector key ids (mosto-cms-auth key-id <key>), comma separated
# MOSTO_CMS_REVOKED_KEYS=

# Local only: also commit each publish with git (turns on History and Undo in /admin)
# MOSTO_CMS_FS_GIT=1

# Production: commit content to GitHub instead of the local disk
# MOSTO_CMS_GITHUB_REPO=owner/repo
# MOSTO_CMS_GITHUB_BRANCH=main
# MOSTO_CMS_GITHUB_TOKEN=
