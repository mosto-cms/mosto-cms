{
  "$schema": "../../packages/core/schema.json",
  "version": 1,
  "site": { "name": "Mosto CMS starter" },
  "locales": ["en"],
  "collections": [
    {
      "key": "home",
      "file": "content/home.json",
      "idField": "id",
      "type": "single",
      "label": "Home page",
      "fields": [
        { "path": "en.hero.title", "kind": "text", "label": "Headline", "required": true, "maxLength": 80 },
        { "path": "en.hero.subtitle", "kind": "multiline", "label": "Subtitle", "maxLength": 240 },
        { "path": "en.highlights", "kind": "list", "label": "Highlights", "maxItems": 6, "maxLength": 40 },
        { "path": "hero.image", "kind": "image", "label": "Hero image" }
      ]
    },
    {
      "key": "products",
      "file": "content/products.json",
      "idField": "slug",
      "type": "list",
      "titleField": "{locale}.name",
      "label": "Menu",
      "fields": [
        { "path": "en.name", "kind": "text", "label": "Name", "required": true, "maxLength": 60 },
        { "path": "en.description", "kind": "text", "label": "Description", "maxLength": 140 },
        { "path": "price", "kind": "text", "label": "Price", "ai": { "locked": true } }
      ]
    }
  ]
}
