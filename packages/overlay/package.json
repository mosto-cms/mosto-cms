{
  "name": "@mosto-cms/overlay",
  "version": "0.0.0",
  "description": "Mosto CMS click-to-edit overlay for the live site: highlights annotated elements inside the /admin iframe and talks to it over a versioned, origin-checked postMessage protocol. Plus mostoField() to write annotations. No dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mosto-cms/mosto-cms.git",
    "directory": "packages/overlay"
  },
  "keywords": ["cms", "mosto-cms", "visual-editing", "click-to-edit"],
  "exports": {
    ".": {
      "mosto-cms-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  }
}
