{
  "name": "mosto-cms-monorepo",
  "private": true,
  "description": "Mosto CMS: open-source, git-based CMS with click-to-edit on the real site.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mosto-cms/mosto-cms.git"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter mosto-cms-starter build && vitest run --config vitest.e2e.config.ts",
    "lint": "eslint .",
    "guard": "node scripts/guard.mjs",
    "check": "pnpm guard && pnpm lint && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
